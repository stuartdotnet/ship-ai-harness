# Copy to .env and fill in. .env is gitignored.
#
# Note: Azure.AI.Projects exposes no chat-client entry point, so a Foundry deployment is
# reached through its Azure OpenAI endpoint rather than through AIProjectClient.
# See docs/gotchas.md #7.

# https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# The deployment name, not the model name.
AZURE_OPENAI_DEPLOYMENT=

# Optional. Leave blank to authenticate with Entra ID via DefaultAzureCredential,
# which is the better default: nothing to leak if you commit this file by mistake.
AZURE_OPENAI_API_KEY=

# Optional. Which scenario to fly. Defaults to derelict-freighter.
SHIPAI_SCENARIO=derelict-freighter

# Optional. Fix the seed to make a voyage reproducible. Defaults to 1701.
SHIPAI_SEED=1701
